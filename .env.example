# GitHub
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# Poller interval (seconds)
POLL_INTERVAL=60

# Base URL of this app (for Teams action buttons)
APP_BASE_URL=http://localhost:5000

# Microsoft Teams incoming webhook URL
TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/webhookb2/xxx

# ──────────────────────────────────────────────
# TARGET APPLICATION (your Node.js service)
# ──────────────────────────────────────────────

# CloudWatch log group of your Node.js app
CLOUDWATCH_LOG_GROUP=/aws/eks/auth-api

# GitHub repo — used for polling, code fetch, auto-fix PRs (comma-separated for multiple)
GITHUB_REPO=your-org/your-nodejs-repo

# APIs to monitor (comma-separated, from your Node.js app)
MONITORED_APIS=/api/users,/api/orders,/api/payments

# ──────────────────────────────────────────────
# SYNAPSE OPS INFRASTRUCTURE
# ──────────────────────────────────────────────

# DynamoDB tables (agent's own storage)
DYNAMODB_TABLE_PREFIX=synapse-ops

# Redis (agent's cache layer)
REDIS_URL=redis://redis-service:6379/0

# Amazon Bedrock (LLM for analysis + chat + auto-fix)
BEDROCK_REGION=us-east-1

# ──────────────────────────────────────────────
# THRESHOLDS
# ──────────────────────────────────────────────

ERROR_RATE_THRESHOLD=50.0
SLOW_API_THRESHOLD_MS=2000
MONITORING_INTERVAL_SECONDS=60
ALERT_COOLDOWN_MINUTES=60

# Chat rate limiting
CHAT_RATE_LIMIT_PER_MINUTE=30
